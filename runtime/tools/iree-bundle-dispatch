"""
Multi-dispatch direct-call benchmark builder.

Builds a minimal bare-metal ELF that directly invokes specified dispatch
kernels from a compiled VMFB, bypassing the IREE VM runtime overhead.

Usage:
  python3 dispatch_bench.py build/ivit/block_b0 --dispatches 2,3
  python3 dispatch_bench.py build/ivit/block_b0 --dispatches 2,3 --run gemmini
"""
