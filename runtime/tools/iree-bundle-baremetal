TYPE_TABLE = {
    "bf16": ("IREE_HAL_ELEMENT_TYPE_BFLOAT_16", 2),
    "f32": ("IREE_HAL_ELEMENT_TYPE_FLOAT_32", 4),
    "f16": ("IREE_HAL_ELEMENT_TYPE_FLOAT_16", 2),
    "i64": ("IREE_HAL_ELEMENT_TYPE_SINT_64", 8),
    "i32": ("IREE_HAL_ELEMENT_TYPE_SINT_32", 4),
    "i16": ("IREE_HAL_ELEMENT_TYPE_SINT_16", 2),
    "i8": ("IREE_HAL_ELEMENT_TYPE_SINT_8", 1),
    "u64": ("IREE_HAL_ELEMENT_TYPE_UINT_64", 8),
    "u32": ("IREE_HAL_ELEMENT_TYPE_UINT_32", 4),
    "u16": ("IREE_HAL_ELEMENT_TYPE_UINT_16", 2),
    "u8": ("IREE_HAL_ELEMENT_TYPE_UINT_8", 1),
}

TYPE_ALIASES = {
    "si64": "i64",
    "si32": "i32",
    "si16": "i16",
    "si8": "i8",
    "ui64": "u64",
    "ui32": "u32",
    "ui16": "u16",
    "ui8": "u8",
}

DEFAULT_LITERAL_ELEMENT = "i32"
PRIMITIVE_KIND_MAP = {
    "i": ("IREE_BAREMETAL_INPUT_KIND_I32", "i32", "(int32_t){}"),
    "I": ("IREE_BAREMETAL_INPUT_KIND_I64", "i64", "(int64_t){}"),
    "f": ("IREE_BAREMETAL_INPUT_KIND_F32", "f32", "{}f"),
    "F": ("IREE_BAREMETAL_INPUT_KIND_F64", "f64", "{}"),
}


def parse_shape_and_type(
    shape_part: str,
    *,
    allow_default_scalar: bool = False,
    force_unit_shape: bool = False,
) -> Tuple[List[int], str, str, int]:
    dims_tokens = shape_part.split("x") if shape_part else []
    if not dims_tokens:
        if not allow_default_scalar:
            raise ValueError(f"Missing shape/type in '{shape_part}'")
        element_token = DEFAULT_LITERAL_ELEMENT
        dims: List[int] = []
    else:
        element_token = dims_tokens[-1]
        dims = [int(token) for token in dims_tokens[:-1] if token]
    element_token = TYPE_ALIASES.get(element_token, element_token)
    if element_token not in TYPE_TABLE:
        raise ValueError(f"Unsupported element type '{element_token}'")
    element_const, element_size = TYPE_TABLE[element_token]
    if force_unit_shape and not dims:
        dims = [1]
    return dims, element_token, element_const, element_size


def float_to_bf16_bytes(value: float) -> bytes:
    bits = struct.unpack("<I", struct.pack("<f", value))[0]
    rounding_bias = ((bits >> 16) & 1) + 0x7FFF
    bf16 = (bits + rounding_bias) >> 16
    return bf16.to_bytes(2, "little")


def serialize_scalar_literal(value: str, element_token: str) -> bytes:
    value = value.strip()
    if not value:
        raise ValueError("Literal input is empty.")
    if element_token in {"i64", "i32", "i16", "i8", "u64", "u32", "u16", "u8"}:
        signed = element_token.startswith("i")
        bits = TYPE_TABLE[element_token][1] * 8
        parsed = int(value, 0)
        if signed:
            min_val = -(1 << (bits - 1))
            max_val = (1 << (bits - 1)) - 1
        else:
            min_val = 0
            max_val = (1 << bits) - 1
        if not (min_val <= parsed <= max_val):
            raise ValueError(
                f"Value {parsed} does not fit in {element_token} (range {min_val}..{max_val})."
            )
        return parsed.to_bytes(TYPE_TABLE[element_token][1], byteorder="little", signed=signed)
    if element_token == "f32":
        return struct.pack("<f", float(value))
    if element_token == "f16":
        return struct.pack("<e", float(value))
    if element_token == "bf16":
        return float_to_bf16_bytes(float(value))
    raise ValueError(f"Literal inputs not supported for element type '{element_token}'.")


